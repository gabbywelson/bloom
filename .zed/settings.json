// Project settings for Zed: https://zed.dev/docs/configuring-zed#settings-files
{
  // Run the Effect-patched native TypeScript (tsgo) LSP in place of vtsls,
  // so Effect language-service diagnostics show in the editor.
  // `bun install` patches this binary via the `prepare` script.
  "lsp": {
    "vtsls": {
      "binary": {
        "path": "node_modules/.bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      },
      // Never auto-import from the vendored reference sources in repos/.
      // Zed passes patterns through unresolved, so anchor with **/ rather
      // than relying on VS Code's workspace-relative "repos/**".
      "settings": {
        "typescript": {
          "preferences": {
            "autoImportFileExcludePatterns": ["**/repos/**"]
          }
        },
        "javascript": {
          "preferences": {
            "autoImportFileExcludePatterns": ["**/repos/**"]
          }
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."]
    },
    "TSX": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."]
    }
  },
  // Hide repos/ (git subtrees kept for coding agents) from the project panel,
  // file finder, project search and file watcher. This setting replaces
  // Zed's defaults rather than extending them, so they are repeated here.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "repos/**"
  ]
}
