{
  "name": "@bloom/web",
  "version": "0.0.0",
  "private": true,
  "description": "Bloom web client: SvelteKit 3 + Svelte 5 runes PWA. Talks only to the API via the typed client from @bloom/api.",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "bun run check",
    "test": "bun test --pass-with-no-tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@bloom/api": "workspace:*",
    "@bloom/domain": "workspace:*",
    "better-auth": "^1.7.7",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
