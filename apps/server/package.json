{
  "name": "@bloom/server",
  "version": "0.0.0",
  "private": true,
  "description": "The one long-running Bun + Effect process: HTTP API, auth, agent runtime, pg-boss workers, telemetry export.",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "auth:link": "bun run src/cli/auth-link.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@bloom/agent": "workspace:*",
    "@bloom/api": "workspace:*",
    "@bloom/db": "workspace:*",
    "@bloom/domain": "workspace:*",
    "@bloom/integrations": "workspace:*",
    "@bloom/pipeline": "workspace:*",
    "@effect/ai-anthropic": "4.0.0",
    "@effect/ai-openai": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "better-auth": "^1.7.7",
    "effect": "4.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
