{
  // Editor + whole-repo typecheck for every Effect/TS workspace. apps/web is
  // a SvelteKit project and is checked separately with svelte-check.
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/db/migrations/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/server/test/**/*.ts"
  ],
  // repos/ holds vendored reference sources (git subtrees) for coding agents
  "exclude": ["node_modules", "repos", "apps/web"]
}
