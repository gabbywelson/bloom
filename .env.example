# Copy to .env (gitignored). Values here are safe local-dev defaults.
#
# Secrets: either paste real values into .env.local (gitignored, loaded by Bun),
# or keep 1Password references here and start the server through
#   bun run dev:op        # = op run --env-file=.env -- bun run dev
# which resolves every op:// reference at launch without writing it to disk.

# --- Server ---------------------------------------------------------------
PORT=3000
# Public origin of the web app. In dev the Vite server proxies /api to :3000,
# so the browser only ever sees this origin (cookies + passkeys need that).
BLOOM_WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloom

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes
# WebAuthn relying party. Must match the host the browser uses.
BLOOM_PASSKEY_RP_ID=localhost
BLOOM_PASSKEY_RP_NAME=Bloom

# --- The single user (seeded by `bun run db:seed`) --------------------------
BLOOM_OWNER_EMAIL=you@example.com
BLOOM_OWNER_NAME=You

# --- Models -------------------------------------------------------------------
# ApiKeyProvider. Anthropic is the default provider; OpenAI is optional.
ANTHROPIC_API_KEY=op://<vault-id>/Anthropic API Key/password
# OPENAI_API_KEY=
# Routing table overrides, one per run type, "provider:model" or just "model"
# (providers: api_key | chatgpt_plan | decision; see packages/agent/src/routing.ts)
# BLOOM_MODEL_CONVERSATION=api_key:claude-opus-5-5
# BLOOM_MODEL_SIDE_THREAD=claude-opus-5-5
# BLOOM_MODEL_PLAN=claude-opus-5-5
# BLOOM_MODEL_SUMMARIZE=claude-haiku-4-5
# BLOOM_MODEL_TRIAGE=api_key:claude-haiku-4-5
# Path to the persona document (default: docs/SOUL.md in the repo)
# BLOOM_SOUL_PATH=
# Owner's IANA time zone, used by the interruption policy for quiet hours
BLOOM_TIME_ZONE=America/Los_Angeles

# --- Telemetry --------------------------------------------------------------
# OTLP/HTTP base URL of the local collector (docker compose). Leave empty to
# disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bloom-server
# Langfuse UI for debugging links (traces arrive via the collector, not directly).
# Langfuse is opt-in: bun run infra:up:langfuse (ADR 0010).
LANGFUSE_HOST=http://localhost:3200
