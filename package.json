{
  "name": "bloom",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && lefthook install",
    "dev": "bun run dev:server & bun run dev:web; wait",
    "dev:server": "bun run --watch apps/server/src/main.ts",
    "dev:web": "bun run --filter @bloom/web dev",
    "dev:op": "op run --env-file=.env -- bun run dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "bun run packages/db/scripts/migrate.ts",
    "db:seed": "bun run packages/db/scripts/seed.ts",
    "auth:link": "bun run apps/server/src/cli/auth-link.ts",
    "openapi": "bun run packages/api/scripts/emit-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter @bloom/web check",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run --filter './packages/*' --filter './apps/*' test",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "start:server": "bun run apps/server/src/main.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.48.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7"
  }
}
